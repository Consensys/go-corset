// Truncating cast whose result is destructured: with u16 limbs on
// KOALABEAR_16, "x as u32" discards the top two u16 limbs of x, and the
// chunking in split.Concat produces a chunk with neither targets nor sources.
pub input data(address:u2) -> (word:u64)

fn main() {
    var x:u64 = data[0]
    var r:u64 = data[1]
    var lo:u16, hi:u16
    //
    hi::lo = x as u32
    //
    if r != (hi::lo) as u64 {
        fail
    }
}
